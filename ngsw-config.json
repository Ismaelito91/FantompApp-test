{
   "$schema": "./node_modules/@angular/service-worker/config/schema.json",
   "index": "/index.html",
   "assetGroups": [
      {
         "name": "app",
         "installMode": "prefetch",
         "resources": {
            "files": [
               "/favicon.png",
               "/index.csr.html",
               "/index.html",
               "/manifest.webmanifest",
               "/manifest-icon1.webmanifest",
               "/*.css",
               "/*.js"
            ]
         }
      },
      {
         "name": "assets",
         "installMode": "prefetch",
         "updateMode": "prefetch",
         "resources": {
            "files": [
               "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|json|txt)"
            ]
         }
      }
   ],
   "dataGroups": [
      {
         "name": "fonts-cache-first",
         "urls": [
            "/**/*.woff",
            "/**/*.woff2",
            "/**/*.ttf",
            "/**/*.otf"
         ],
         "cacheConfig": {
            "strategy": "performance",
            "maxSize": 20,
            "maxAge": "365d"
         }
      },
      {
         "name": "api-images-performance",
         "urls": [
            "/**/api/public/images/*"
         ],
         "cacheConfig": {
            "strategy": "performance",
            "maxSize": 300,
            "maxAge": "30d"
         }
      },
      {
         "name": "api-config-performance",
         "urls": [
            "/**/api/config"
         ],
         "cacheConfig": {
            "strategy": "performance",
            "maxSize": 1,
            "maxAge": "7d"
         }
      },
      {
         "name": "api-freshness",
         "urls": [
            "/**/api/*"
         ],
         "cacheConfig": {
            "strategy": "freshness",
            "maxSize": 50,
            "maxAge": "7d",
            "timeout": "5s"
         }
      }
   ]
}
